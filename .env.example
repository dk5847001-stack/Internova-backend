# Core backend
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/internova
JWT_SECRET=replace-with-strong-random-secret

# Canonical frontend/public URLs
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_PROGRAM_PATH_TEMPLATE=/internships/:slug

# Public support contact shown in program detail payloads
SUPPORT_EMAIL=support@internovatech.in

# AI Support Agent (set your own credentials; keep secret)
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Keep internal model reasoning out of customer-visible chat replies.
NVIDIA_REASONING_BUDGET=0
